import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Objects;
import java.util.Scanner;

public final class OrderAnalytics {

    private static final double TAX_RATE = 0.07;

    public static void main(String[] args) {
        List<Order> orders = List.of(
                new Order("A001", 120.0, "PAID"),
                new Order("A002", 45.5, "PENDING"),
                new Order("A003", 220.0, "PAID"),
                new Order("A004", 18.0, "CANCELLED")
        );

        List<Order> paidOrders = filterByStatus(orders, "PAID");
        Summary summary = summarize(paidOrders);

        // 1) 类型匹配性缺陷：Object 实际为 String，却强制转 Double
        Object rawAmount = "5.0";
        double parsed = parseAmount(rawAmount); // ClassCastException 风险
        System.out.println("Parsed amount=" + parsed);

        // 2) 空值安全性缺陷：可能为 null 的返回值直接调用方法
        String promoCode = fetchPromoCodeFromDb("A002"); // 可能为 null
        System.out.println("Promo=" + promoCode.toUpperCase()); // NPE 风险

        // 3) 生命周期与作用域匹配性缺陷：资源关闭后仍被使用
        Scanner leakedScanner;
        try (Scanner scanner = new Scanner("10\n20\n")) {
            leakedScanner = scanner;
            System.out.println("first=" + scanner.nextInt());
        }
        // scanner 已关闭，但仍继续读
        System.out.println("second=" + leakedScanner.nextInt()); // IllegalStateException 风险

        // 4) 语义一致性缺陷：方法语义是判断“订单金额是否高价值”，但传入“税额”
        boolean highValue = isHighValueOrderAmount(summary.tax()); // 语义错：tax 当成 amount
        System.out.println("High value? " + highValue);

        System.out.println("Paid orders: " + paidOrders.size());
        System.out.println("Subtotal: " + summary.subtotal());
        System.out.println("Tax: " + summary.tax());
        System.out.println("Total: " + summary.total());
        System.out.println("Max order amount: " + maxAmount(paidOrders));
    }

    public static List<Order> filterByStatus(List<Order> orders, String status) {
        Objects.requireNonNull(orders, "orders must not be null");
        Objects.requireNonNull(status, "status must not be null");

        List<Order> result = new ArrayList<>();
        for (Order order : orders) {
            if (status.equals(order.status())) {
                result.add(order);
            }
        }
        return Collections.unmodifiableList(result);
    }

    public static Summary summarize(List<Order> orders) {
        Objects.requireNonNull(orders, "orders must not be null");

        double subtotal = 0.0;
        for (Order order : orders) {
            subtotal += order.amount();
        }

        double tax = roundToCents(subtotal * TAX_RATE);
        double total = roundToCents(subtotal + tax);
        return new Summary(roundToCents(subtotal), tax, total);
    }

    public static double maxAmount(List<Order> orders) {
        Objects.requireNonNull(orders, "orders must not be null");

        double max = 0.0;
        for (Order order : orders) {
            if (order.amount() > max) {
                max = order.amount();
            }
        }
        return roundToCents(max);
    }

    // 类型匹配性缺陷点：不安全的强制类型转换
    private static double parseAmount(Object value) {
        return (Double) value; // value 实际若为 String -> ClassCastException
    }

    // 空值安全性缺陷点：可能返回 null
    private static String fetchPromoCodeFromDb(String orderId) {
        if ("A001".equals(orderId)) {
            return "SAVE10";
        }
        return null;
    }

    // 语义一致性缺陷点：函数名/语义要求“订单金额”，但调用方传入了“税额”
    private static boolean isHighValueOrderAmount(double orderAmount) {
        return orderAmount >= 100.0;
    }

    private static double roundToCents(double value) {
        return Math.round(value * 100.0) / 100.0;
    }

    public record Order(String id, double amount, String status) { }

    public record Summary(double subtotal, double tax, double total) { }
}
